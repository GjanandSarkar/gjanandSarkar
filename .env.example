# ==========================================
# DairyDirect — Environment Variables Template
# ==========================================

# ─── Supabase Configuration ────────────────
# Get these from: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Admin Permissions ─────────────────────
# Used for backend operations and database hooks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Backend Service ───────────────────────
# Port for the standalone Express service (optional)
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Auth Settings ──────────────────────────
# Set to 'true' to bypass real OTP in development
NEXT_PUBLIC_DEMO_MODE=true
