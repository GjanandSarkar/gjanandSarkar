{
  "info": {
    "name": "DairyDirect API",
    "description": "Complete API collection for DairyDirect backend. Set {{base_url}} to http://localhost:3000 and {{token}} after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "🔍 Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/otp/send",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Verify OTP (Customer Login)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const r = pm.response.json();", "if (r.data?.token) pm.collectionVariables.set('token', r.data.token);"]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"123456\"\n}" }
          }
        },
        {
          "name": "Verify OTP (Admin Login)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const r = pm.response.json();", "if (r.data?.token) pm.collectionVariables.set('admin_token', r.data.token);"]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9000000001\",\n  \"otp\": \"123456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "👤 User",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ravi Patel Updated\"\n}" }
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/address",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"street\": \"14 Shyamal Cross Road\",\n  \"area\": \"Satellite\",\n  \"city\": \"Ahmedabad\",\n  \"pincode\": \"380015\",\n  \"lat\": 23.0225,\n  \"lng\": 72.5714,\n  \"isDefault\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🛒 Products",
      "item": [
        {
          "name": "List All Products",
          "request": { "method": "GET", "url": "{{base_url}}/products" }
        },
        {
          "name": "List Milk Products Only",
          "request": { "method": "GET", "url": "{{base_url}}/products?category=MILK" }
        },
        {
          "name": "Get Product by ID",
          "request": { "method": "GET", "url": "{{base_url}}/products/prod_milk_001" }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cow Milk\",\n  \"category\": \"MILK\",\n  \"description\": \"Pure A2 cow milk\",\n  \"imageUrl\": \"https://source.unsplash.com/300x300/?cow,milk\",\n  \"variants\": [\n    { \"label\": \"500ml\", \"price\": 30, \"stock\": 100 },\n    { \"label\": \"1L\", \"price\": 58, \"stock\": 80 }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📦 Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"demo_addr_01\",\n  \"paymentMode\": \"MOCK\",\n  \"items\": [\n    { \"variantId\": \"var_milk_1L\", \"quantity\": 2 },\n    { \"variantId\": \"var_paneer_200g\", \"quantity\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "My Orders (Filter by Status)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders?status=PENDING",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/orders/ORDER_ID_HERE/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" }
          }
        }
      ]
    },
    {
      "name": "🔄 Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/subscriptions",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"var_milk_1L\",\n  \"quantity\": 2,\n  \"frequency\": \"DAILY\",\n  \"startDate\": \"2026-04-13\"\n}"
            }
          }
        },
        {
          "name": "My Subscriptions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/subscriptions/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/subscriptions/SUBSCRIPTION_ID_HERE/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Pause Subscription",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/subscriptions/SUBSCRIPTION_ID_HERE/pause",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Resume Subscription",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/subscriptions/SUBSCRIPTION_ID_HERE/resume",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "🚨 Quality Reports",
      "item": [
        {
          "name": "File Quality Report",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/reports",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORDER_ID_HERE\",\n  \"issueType\": \"SPOILED\",\n  \"description\": \"The milk smelled sour. Packaging was intact but product quality was poor.\"\n}"
            }
          }
        },
        {
          "name": "My Reports",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "All Reports (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports?status=OPEN",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Resolve Report (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/reports/REPORT_ID_HERE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"resolution\": \"Replacement dispatched. Production batch reviewed and discarded.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🛠️ Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Orders (Filter Pending)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/orders?status=PENDING",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Subscriptions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/subscriptions",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Revenue Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/revenue",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Demand Forecast",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/demand",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Trigger Subscription Orders (Manual)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/cron/trigger",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    }
  ]
}
