# ================================================
# DairyDirect Backend - Environment Configuration
# ================================================
# 1. Copy this file:     cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git — it is gitignored
# ================================================


# --- Supabase ---
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Server ---
PORT=3000
NODE_ENV=development           # development | production

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Logging ---
LOG_LEVEL=info                 # error | warn | info | debug

# --- MSG91 (SMS / OTP) - optional ---
# MSG91_API_KEY=your_msg91_api_key_here
# MSG91_TEMPLATE_ID=your_msg91_template_id_here
