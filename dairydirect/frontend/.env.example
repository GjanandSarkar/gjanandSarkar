# =============================================================================
# 🥛 Gjanand Sarkar (DairyDirect) — General Environment Variables Template
# Copy this file to .env.local or .env and fill in your real values.
# NEVER commit real credentials to Git.
# =============================================================================

# ─── App Configuration ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Admin & Service Role Key ────────────────────────────────────────────────
# WARNING: Never expose service_role key in the browser. Server/Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Direct PostgreSQL & Connection Pooler URIs ──────────────────────────────
# Get from: Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Admin Email & Phone Access Controls ─────────────────────────────────────
# Comma-separated list of admin email addresses and phone numbers
# WARNING: Server-only variables. Do NOT prefix with NEXT_PUBLIC_
ADMIN_EMAILS=admin@gjanandsarkar.com
ADMIN_EMAIL=admin@gjanandsarkar.com
ADMIN_PHONES=+919876543210

# ─── Razorpay Payment Gateway ────────────────────────────────────────────────
# Get from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── ImageKit CDN Configuration ──────────────────────────────────────────────
# Get from: ImageKit Dashboard -> Developer Options -> API Keys
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# ─── Mapbox Maps Configuration ───────────────────────────────────────────────
# Get from: Mapbox Dashboard -> Access Tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
# Get from: Sentry Dashboard -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Session Security & JWT Secrets ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_32_plus_char_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_plus_char_jwt_refresh_secret_here

# ─── Redis Cache & Distributed Rate Limiting ─────────────────────────────────
# Redis connection URL — used for caching, OTP storage, and distributed rate limiting.
# The application GRACEFULLY DEGRADES to in-memory fallback when REDIS_URL is not set.
#
# Options:
#   Local Redis      : redis://localhost:6379
#   With auth        : redis://default:your-password@localhost:6379
#   TLS (Upstash etc): rediss://default:your-password@your-host:6380
#   AWS ElastiCache  : redis://your-cluster.cache.amazonaws.com:6379
#   Redis Cloud      : redis://default:your-password@redis-host.cloud.redislabs.com:port
#
# Cached endpoints (TTL):
#   GET /api/products          — 120s (product list, jittered)
#   GET /api/products/[id]     — 300s (product detail, jittered)
#   GET /api/categories        — 1800s (category list, jittered)
#   GET /api/sellers           — 300s (seller profile, scoped by userId)
#   GET /api/sellers/analytics — 120s (seller analytics, scoped by sellerId)
#   GET /api/admin/stats       — 60s  (admin KPIs)
#   GET /api/admin/analytics   — 120s (admin analytics)
REDIS_URL=redis://default:your-redis-password@localhost:6379
