# =============================================================================
# 🥛 Gjanand Sarkar (DairyDirect) — Supabase Production Environment Template
# Copy this file to .env.supabase or .env.local and fill in your real values.
# NEVER commit real production credentials to Git.
# =============================================================================

# ─── App Configuration ───────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://gjanandsarkar.com
NEXT_PUBLIC_SITE_URL=https://gjanandsarkar.com

# ─── Supabase Pro Backend (Project Settings > API) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Direct PostgreSQL & Connection Pooler URIs ──────────────────────────────
# Direct PostgreSQL Connection URI (Project Settings > Database > Connection URI)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
# Transaction Connection Pooler (Port 6543)
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Redis Cache & Rate-Limiting (Upstash / Redis Cloud / Self-hosted) ────────
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# ─── Razorpay Payment Gateway (Dashboard > Settings > API Keys) ──────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── ImageKit CDN Configuration ──────────────────────────────────────────────
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# ─── Mapbox Maps Configuration ───────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Session Security & JWT Secrets (Min 32 characters each) ─────────────────
JWT_SECRET=your_32_plus_char_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_plus_char_jwt_refresh_secret_here

# ─── Store Administration ────────────────────────────────────────────────────
# Comma-separated list of admin email addresses and verified phone numbers
ADMIN_EMAILS=admin@gjanandsarkar.com
ADMIN_EMAIL=admin@gjanandsarkar.com
ADMIN_PHONES=+919876543210
