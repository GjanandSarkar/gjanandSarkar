# ============================================================
# DairyDirect — AWS Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.
# ============================================================

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://gjanandsarkar.com
NODE_ENV=production

# ─── AWS Credentials (Use IAM Role in production — NOT hardcoded keys) ──
# CRITICAL: Use AWS IAM roles/instance profiles in production instead of keys
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1

# ─── Amazon RDS (PostgreSQL) ──────────────────────────────────
# Find your RDS endpoint in AWS Console → RDS → Instances → Your DB
AWS_RDS_HOST=your-rds-endpoint.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=dairydirect
AWS_RDS_USERNAME=dairydirect_admin
AWS_RDS_PASSWORD=your_strong_password_here
# Note: Generate a strong password: openssl rand -base64 32

# ─── Amazon ElastiCache (Redis) ───────────────────────────────
# Find your Redis endpoint in AWS Console → ElastiCache → Clusters
REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379
# For TLS (production):
# REDIS_URL=rediss://your-elasticache-endpoint.cache.amazonaws.com:6379

# ─── Amazon S3 ────────────────────────────────────────────────
AWS_S3_BUCKET_NAME=gjanandsarkar-assets
# Optional: CloudFront domain for CDN-served assets
AWS_CLOUDFRONT_DOMAIN=d1234abcdef.cloudfront.net

# ─── Amazon SES (Email) ───────────────────────────────────────
# Verify this email domain in AWS SES console first!
AWS_SES_FROM_EMAIL=orders@gjanandsarkar.com
# Admin notification email
ADMIN_EMAIL=patelroshu1218@gmail.com

# ─── Amazon SNS (SMS OTP) ─────────────────────────────────────
AWS_SNS_SENDER_ID=GJANSRKAR
# Admin phone numbers for admin login (comma-separated, with +91)
ADMIN_PHONES=+91XXXXXXXXXX,+91XXXXXXXXXX

# ─── JWT Authentication ───────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your_very_long_jwt_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=your_different_refresh_secret_here

# ─── Razorpay (Payment Gateway) ───────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Public key (safe to expose in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX

# ─── Business Settings ────────────────────────────────────────
# Admin email addresses (for old Google Auth compatibility)
ADMIN_EMAILS=admin@gjanandsarkar.com,patelroshu1218@gmail.com

# ─── Development Only ─────────────────────────────────────────
# Set to 'true' to return OTP in API response (DEV ONLY, never production)
# DEMO_MODE=true

# ─── Legacy Supabase (for migration period only — remove after migration) ──
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
