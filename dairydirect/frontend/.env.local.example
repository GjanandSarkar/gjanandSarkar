# DairyDirect — Environment Variables
# Copy this file to .env.local and fill in your real values

# ─── Supabase ───────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Never expose this in the browser. Server/Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── MSG91 (OTP SMS) ────────────────────────────────────────
# Get from: https://msg91.com/dashboard
# The auth key from your MSG91 account
MSG91_AUTH_KEY=your-msg91-auth-key

# Template ID for OTP SMS template in MSG91
MSG91_TEMPLATE_ID=your-msg91-template-id

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
