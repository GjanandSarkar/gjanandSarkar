# Gjanand Sarkar — Environment Variables
# Copy this file to .env.local and fill in your real values

# ─── Supabase ───────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WARNING: Never expose this in the browser. Server/Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google OAuth ──────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Admin Emails (comma-separated) ────────────────────────
# Users with these emails get admin role automatically on first login
NEXT_PUBLIC_ADMIN_EMAILS=admin@gjanandsarkar.com

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
