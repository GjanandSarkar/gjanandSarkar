# ==========================================
# Gjanand Sarkar — Environment Variables Template
# Copy this file to .env.local and fill in your real values
# ==========================================

# ─── Supabase Configuration ────────────────
# Get these from: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Admin Permissions ─────────────────────
# Used for backend operations and database hooks
# WARNING: Never expose this in the browser. Server/Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google OAuth ──────────────────────────
# Get from: Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Admin Emails ──────────────────────────
# Comma-separated list of emails that get admin role automatically
# WARNING: Server-only variable. Do NOT prefix with NEXT_PUBLIC_
ADMIN_EMAILS=admin@gjanandsarkar.com

# ─── Sentry Error Tracking ─────────────────
# Get from: Sentry Dashboard -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── App URL ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
