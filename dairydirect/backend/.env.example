# ============================================================
# DairyDirect (Gjanand Sarkar) — Backend Environment Configuration
# ============================================================

# ─── Server Settings ──────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# ─── Database Configuration (PostgreSQL / Supabase / AWS RDS) ─
# Option 1: Full connection URI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dairydirect

# Option 2: Individual host credentials (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dairydirect
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ─── Supabase Integration (Optional/Direct Access) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Authentication & JWT ────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_must_be_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_must_be_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# ─── Admin Permissions ───────────────────────────────────────
ADMIN_EMAILS=admin@gjanandsarkar.com,patelroshu1218@gmail.com
ADMIN_PHONES=+919876543210,+919000000001

# ─── Razorpay Payment Gateway ────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── ImageKit Cloud Storage ──────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── Development & Demo Settings ─────────────────────────────
# In demo mode, OTP is returned in the API response for testing
DEMO_MODE=true

