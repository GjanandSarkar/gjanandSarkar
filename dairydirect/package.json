{
  "name": "dairydirect",
  "version": "1.0.0",
  "description": "DairyDirect — Hyper-local dairy delivery platform",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
