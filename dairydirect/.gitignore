# Global ignore rules for the monorepo

# Dependencies
**/node_modules/

# Environment and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.local.example

# Build outputs and caches
**/.next/
**/out/
**/dist/
**/build/
**/coverage/
**/.turbo/
**/.cache/
**/*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# macOS metadata
.DS_Store
._*